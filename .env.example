# Copy to .env and set your own strong password before starting Docker.
GATEWAY_PUBLIC_URL=http://127.0.0.1:8317
GATEWAY_ADMIN_PASSWORD=
GATEWAY_API_BODY_LIMIT_MB=64
# Optional: proxy used only by the ChatGPT desktop download job.
# MH_TOOL_PROXY=http://127.0.0.1:7890
# Optional: request image compression (off | opencode | all).
# MH_IMAGE_OPTIMIZATION=opencode
# MH_IMAGE_MAX_DIMENSION=1600
# MH_IMAGE_QUALITY=80